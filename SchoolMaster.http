@SchoolMaster_HostAddress = http://localhost:7001
@tenantSubdomain = susie.academy.edu
@token = <paste-jwt-token-here>
@academicYearId = <paste-academic-year-id-here>
@termId = <paste-term-id-here>
@classId = <paste-class-id-here>
@subjectId = <paste-subject-id-here>
@studentId = <paste-student-id-here>
@studentId2 = <paste-second-student-id-here>

GET {{SchoolMaster_HostAddress}}/weatherforecast/
Accept: application/json

### onboard tenant
POST {{SchoolMaster_HostAddress}}/api/onboarding/tenants
Content-Type: application/json
Accept: application/json

{
  "schoolName": "Susie Academy",
  "subdomain": "susie-academy-edu",
  "contactEmail": "hello@susie.edu",
  "adminEmail": "susanojone@gmail.com",
  "AdminFirstName":"Susan",
  "AdminLastName":"Ojone",
  "adminPassword": "SecurePassword123!"
}

### verify email
POST {{SchoolMaster_HostAddress}}/api/onboarding/verify-email
Content-Type: application/json
Accept: application/json

{
  "email": "susanojone@gmail.com",
  "otpToken": "1419"
}

### resend verification token
POST {{SchoolMaster_HostAddress}}/api/onboarding/resend-verification-token
Content-Type: application/json
Accept: application/json

{
  "email": "susanojone@gmail.com"
}

### forgot password
POST {{SchoolMaster_HostAddress}}/api/onboarding/forgot-password
Content-Type: application/json
Accept: application/json
# X-Tenant-Subdomain: susie.academy.edu

{
  "email": "susanojone@gmail.com"
}

### reset password
POST {{SchoolMaster_HostAddress}}/api/onboarding/reset-password
Content-Type: application/json
Accept: application/json
X-Tenant-Subdomain: susie.academy.edu

{
  "email": "susanojone@gmail.com",
  "otp": "0000",
  "password": "NewSecurePassword123!"
}


"email": "susanojone@gmail.com",
  "password": "NewSecurePassword123!",


########## ACADEMIC API ##########

### ── Academic Years ───────────────────────────────────────────────

### Create academic year
POST {{SchoolMaster_HostAddress}}/api/v1/academic/years
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "2025/2026",
  "startDate": "2025-09-01",
  "endDate": "2026-07-31",
  "setAsCurrent": true
}

### Get academic years (paginated)
GET {{SchoolMaster_HostAddress}}/api/v1/academic/years?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### ── Terms ────────────────────────────────────────────────────────

### Create term
POST {{SchoolMaster_HostAddress}}/api/v1/academic/terms
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "academicYearId": "{{academicYearId}}",
  "name": "First Term",
  "termNumber": 1,
  "startDate": "2025-09-01",
  "endDate": "2025-12-20",
  "setAsCurrent": true
}

### Get terms by academic year
GET {{SchoolMaster_HostAddress}}/api/v1/academic/years/{{academicYearId}}/terms
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### ── Classes ──────────────────────────────────────────────────────

### Create class
POST {{SchoolMaster_HostAddress}}/api/v1/academic/classes
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "JSS 1A",
  "formTeacherId": null
}

### Get classes (paginated)
GET {{SchoolMaster_HostAddress}}/api/v1/academic/classes?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### ── Subjects ─────────────────────────────────────────────────────

### Create subject
POST {{SchoolMaster_HostAddress}}/api/v1/academic/subjects
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "Mathematics",
  "code": "MATH"
}

### Create subject — no code (optional field)
POST {{SchoolMaster_HostAddress}}/api/v1/academic/subjects
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "English Language",
  "code": null
}

### Get subjects (paginated)
GET {{SchoolMaster_HostAddress}}/api/v1/academic/subjects?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### ── Timetable (Periods) ──────────────────────────────────────────

### Add timetabled period — name defaults to subject name
POST {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "subjectId": "{{subjectId}}",
  "teacherId": null,
  "dayOfWeek": "Monday",
  "startTime": "08:00:00",
  "endTime": "09:00:00",
  "type": "Timetabled",
  "name": null
}

### Add timetabled period — custom name override
POST {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "subjectId": "{{subjectId}}",
  "teacherId": null,
  "dayOfWeek": "Tuesday",
  "startTime": "08:00:00",
  "endTime": "09:00:00",
  "type": "Timetabled",
  "name": "Advanced Maths"
}

### Add daily register period — name defaults to "Morning Register"
POST {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "subjectId": null,
  "teacherId": null,
  "dayOfWeek": "Monday",
  "startTime": "07:45:00",
  "endTime": "08:00:00",
  "type": "DailyRegister",
  "name": null
}

### Add non-academic period (break, lunch, prep — name required)
POST {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "subjectId": null,
  "teacherId": null,
  "dayOfWeek": "Monday",
  "startTime": "10:30:00",
  "endTime": "10:45:00",
  "type": "NonAcademic",
  "name": "Break"
}

### Get class timetable
GET {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/timetable
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

########## ACADEMIC UPDATE ENDPOINTS (PATCH) ##########

### ── Update academic year ────────────────────────────────────────────────────

### Rename and extend an academic year
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/years/{{academicYearId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "2025/2026 Revised",
  "startDate": "2025-09-01",
  "endDate": "2026-08-15",
  "setAsCurrent": null
}

### Set a different academic year as current (omit fields you are not changing)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/years/{{academicYearId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "setAsCurrent": true
}

### ── Update term ──────────────────────────────────────────────────────────────

### Extend a term's end date only
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/terms/{{termId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "endDate": "2025-12-31"
}

### Rename and set a term as current
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/terms/{{termId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "Autumn Term",
  "setAsCurrent": true
}

### ── Update class ─────────────────────────────────────────────────────────────

### Rename a class (form teacher stays unchanged — field omitted)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "JSS 1B"
}

### Assign a form teacher (name stays unchanged — field omitted)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "formTeacherId": "00000000-0000-0000-0000-000000000001"
}

### Clear form teacher explicitly (null with field present = clear)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "formTeacherId": null
}

### ── Update subject ───────────────────────────────────────────────────────────

### Rename a subject
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/subjects/{{subjectId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "name": "Further Mathematics"
}

### Clear a subject's shortcode (null with field present = clear)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/subjects/{{subjectId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "code": null
}

### ── Update period ────────────────────────────────────────────────────────────

@periodId = <paste-period-id-here>

### Shift a period's time slot (everything else stays)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods/{{periodId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "startTime": "09:00:00",
  "endTime": "10:00:00"
}

### Reassign a period to a different subject
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods/{{periodId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "subjectId": "00000000-0000-0000-0000-000000000002"
}

### Remove teacher assignment from a period (null with field present = clear)
PATCH {{SchoolMaster_HostAddress}}/api/v1/academic/classes/{{classId}}/periods/{{periodId}}
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "teacherId": null
}

########## ATTENDANCE API ##########
# Requires an active academic year AND an active term to be set (see Academic API above),
# otherwise MarkAttendance returns 404 (AcademicYearNotFound / TermNotFound).
# Date format is yyyy-MM-dd. Status is one of: Present, Absent, Late, Excused.

### ── Mark attendance ─────────────────────────────────────────────────

### Mark attendance for a class — mixed statuses (Absent queues a guardian notification)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-17",
  "records": [
    { "studentId": "{{studentId}}",  "status": "Present", "notes": null },
    { "studentId": "{{studentId2}}", "status": "Absent",  "notes": "No call from guardian" }
  ]
}

### Correct a mistake — resubmit same class+date (upsert; flips student2 to Present)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-17",
  "records": [
    { "studentId": "{{studentId2}}", "status": "Present", "notes": "Arrived late, corrected" }
  ]
}

### Late and Excused statuses (both count as attended in the summary percentage)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-16",
  "records": [
    { "studentId": "{{studentId}}",  "status": "Late",    "notes": "15 minutes late" },
    { "studentId": "{{studentId2}}", "status": "Excused", "notes": "Medical appointment" }
  ]
}

### ── Validation / error cases ────────────────────────────────────────

### Future date — expect 400 (cannot mark attendance for a future date)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2099-01-01",
  "records": [
    { "studentId": "{{studentId}}", "status": "Present", "notes": null }
  ]
}

### Empty records — expect 400 (at least one record required)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-17",
  "records": []
}

### Duplicate student in same request — expect 400 (duplicate student IDs not allowed)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-17",
  "records": [
    { "studentId": "{{studentId}}", "status": "Present", "notes": null },
    { "studentId": "{{studentId}}", "status": "Absent",  "notes": null }
  ]
}

### Student not in this class — expect 422 (StudentNotInClass)
POST {{SchoolMaster_HostAddress}}/api/v1/attendance
Content-Type: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

{
  "classId": "{{classId}}",
  "date": "2026-06-17",
  "records": [
    { "studentId": "00000000-0000-0000-0000-000000000099", "status": "Present", "notes": null }
  ]
}

### ── Read attendance ──────────────────────────────────────────────────

### Get class attendance for a specific date
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/class/{{classId}}?date=2026-06-17
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Get student attendance summary — all history
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/student/{{studentId}}
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Get student attendance summary — scoped to a term
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/student/{{studentId}}?termId={{termId}}
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Get student attendance summary — scoped to a date range
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/student/{{studentId}}?from=2026-06-01&to=2026-06-30
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Inverted date range — expect 400 ('from' must be before 'to')
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/student/{{studentId}}?from=2026-06-30&to=2026-06-01
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Unknown student — expect 404 (student not found)
GET {{SchoolMaster_HostAddress}}/api/v1/attendance/student/00000000-0000-0000-0000-000000000099
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

### Get all staff
GET {{SchoolMaster_HostAddress}}/api/v1/staff
Accept: application/json
Authorization: Bearer {{token}}
X-Tenant-Subdomain: {{tenantSubdomain}}

